{
  "name": "seq",
  "version": "1.6.3",
  "description": "seq es un micro orm, modular, flexible y de facil integracion",
  "type": "module",
  "main": "dist/seq.js",
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/seq.js",
      "default": "./dist/seq.js"
    }
  },
  "scripts": {
    "----------------------https://testcontainers.com/------------------": "",
    "test": "node scripts/run-unit-tests.js",
    "test:all": "npm run test && npm run test:mysql && npm run test:oracle11 && npm run test:oracle12 && npm run test:oracle26",
    "test:mysql": "node --test tests/integration/mysql-suite.test.js",
    "test:oracle11": "node --test tests/integration/oracle11-suite.test.js",
    "test:oracle12": "node --test tests/integration/oracle12-suite.test.js",
    "test:oracle26": "node --test tests/integration/oracle26-suite.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "lint": "eslint src tests examples fuzz scripts/run-fuzz.js scripts/verify-fuzz.js",
    "format": "prettier --write src tests examples types README.md package.json",
    "precompile": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "npm run test && rollup -c",
    "dev": "rollup -c -w",
    "example:basic": "node examples/basic.js",
    "example:associations": "node examples/associations.js",
    "example:find": "node examples/find.js",
    "example:include": "node examples/include.js",
    "example:belongs-to-many": "node examples/belongs-to-many.js",
    "example:hooks": "node examples/hooks.js",
    "example:virtual": "node examples/virtual.js",
    "example:cache": "node examples/cache.js",
    "example:timezone": "node examples/timezone.js",
    "examples": "npm run example:basic && npm run example:associations && npm run example:find && npm run example:include && npm run example:belongs-to-many && npm run example:hooks && npm run example:virtual && npm run example:cache",
    "fuzz:sql": "node scripts/run-fuzz.js",
    "fuzz:smoke": "node scripts/run-fuzz.js smoke",
    "fuzz:regression": "node scripts/run-fuzz.js regression",
    "fuzz:replay": "node scripts/run-fuzz.js replay",
    "fuzz:verify": "node scripts/verify-fuzz.js",
    "fuzz:coverage": "node scripts/run-fuzz.js coverage"
  },
  "keywords": [
    "orm",
    "model",
    "database",
    "sqlite",
    "mysql",
    "oracle"
  ],
  "peerDependencies": {
    "better-sqlite3": "^12.11.1",
    "mysql2": "^3.14.0",
    "oracledb": "^5.5.0 || ^26.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "oracledb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jazzer.js/core": "^4.0.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "mysql2": "^3.14.0",
    "oracledb": "26.0.0",
    "prettier": "^3.9.6",
    "rollup": "^4.46.2"
  },
  "author": "Hugo",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "oracledb@5.5.0": true,
    "oracledb@26.0.0": true
  }
}
