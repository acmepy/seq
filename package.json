{
  "name": "seq",
  "version": "1.1.1",
  "description": "seq es un micro orm, modular, flexible y de facil integracion",
  "type": "module",
  "main": "src/index.js",
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "----------------------https://testcontainers.com/------------------":"",
    "test": "node scripts/run-unit-tests.js",
    "test:all": "npm run test && npm run test:mysql && npm run test:oracle11 && npm run test:oracle12",
    "test:mysql": "node --test tests/integration/mysql-suite.test.js",
    "test:oracle11": "node --test tests/integration/oracle11-suite.test.js",
    "test:oracle12": "node --test tests/integration/oracle12-suite.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "lint": "eslint src tests examples",
    "format": "prettier --write src tests examples types README.md package.json",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "prepack": "npm run build",
    "example:basic": "node examples/basic.js",
    "example:associations": "node examples/associations.js",
    "example:find": "node examples/find.js",
    "example:include": "node examples/include.js",
    "example:belongs-to-many": "node examples/belongs-to-many.js",
    "example:hooks": "node examples/hooks.js",
    "example:virtual": "node examples/virtual.js",
    "example:cache": "node examples/cache.js",
    "examples": "npm run example:basic && npm run example:associations && npm run example:find && npm run example:include && npm run example:belongs-to-many && npm run example:hooks && npm run example:virtual && npm run example:cache"
  },
  "keywords": [
    "orm",
    "model",
    "database",
    "sqlite",
    "mysql",
    "oracle"
  ],
  "peerDependencies": {
    "better-sqlite3": "^12.11.1",
    "mysql2": "^3.14.0",
    "oracledb": "^5.5.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "oracledb": {
      "optional": true
    }
  },
  "devDependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "mysql2": "^3.14.0",
    "oracledb": "5.5.0",
    "prettier": "^3.9.6",
    "rollup": "^4.46.2"
  },
  "author": "Hugo",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
